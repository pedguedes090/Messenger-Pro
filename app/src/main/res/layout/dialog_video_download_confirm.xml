<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/dialog_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@+id/dialog_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_dialog_url_container"
        android:padding="12dp"
        android:textAppearance="@style/TextAppearance.MPro.Dialog.Url"
        android:maxLines="2" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_cancel"
            style="@style/Widget.MPro.DialogButton.Cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/video_download_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_other"
            style="@style/Widget.MPro.DialogButton.Other"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/video_download_other_url" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_download"
            style="@style/Widget.MPro.DialogButton.Download"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            app:icon="@drawable/ic_toolbar_download"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            android:text="@string/video_download_download_now" />
    </LinearLayout>

</LinearLayout>
